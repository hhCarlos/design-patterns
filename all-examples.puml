@startuml
class Enemy {
  - name: String
  - strategy: CombatStrategy

  + Enemy(name: String, strategy: CombatStrategy)
  + attack()
  + defense()
  + setStrategy(strategy: CombatStrategy)
}

interface CombatStrategy {
  + attack()
  + defense()
}

class DemonOneStrategy {
  + attack()
  + defense()
}

class DemonTwoStrategy {
  + attack()
  + defense()
}

class DemonThreeStrategy {
  + attack()
  + defense()
}

Enemy o--> CombatStrategy : delegates

CombatStrategy <|.. DemonOneStrategy
CombatStrategy <|.. DemonTwoStrategy
CombatStrategy <|.. DemonThreeStrategy
@enduml
