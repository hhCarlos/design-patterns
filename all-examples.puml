@startuml
class Order {
    - orderTotal: BigDecimal
    - shippingStrategy: ShippingStrategy

    + Order(orderTotal: BigDecimal, shippingStrategy: ShippingStrategy)

    + calculateShippingCost(): BigDecimal
    + setShippingStrategy(ShippingStrategy newStrategy): void
}

interface ShippingStrategy {
    + calculateShippingCost(BigDecimal orderTotal): BigDecimal
}

Order o--> ShippingStrategy : delegates

class StandardShippingStrategy {
    + calculateShippingCost(orderTotal: BigDecimal): BigDecimal
}

class ExpressShippingStrategy {
    + calculateShippingCost(orderTotal: BigDecimal): BigDecimal
}

class StorePickupStrategy {
    + calculateShippingCost(orderTotal: BigDecimal): BigDecimal
}

ShippingStrategy <|.. StandardShippingStrategy
ShippingStrategy <|.. ExpressShippingStrategy
ShippingStrategy <|.. StorePickupStrategy
@enduml
'/
